% ======================================================================
%  ap_pupil_variables_glm_analysis_v2.m
%
%  Downstream of ap_reward_analysis.m. Same pipeline structure as
%  ap_reward_glm_analysis.m, extended with two more predictors:
%
%    InitialBarZ  - InitialBar, Z-SCORED WITHIN EACH SESSION
%                   ((x - mean_session) / std_session), since the raw
%                   max/min for InitialBar varies session to session and
%                   a 1-unit change doesn't mean the same thing in every
%                   session. If a session has zero/NaN std (e.g. constant
%                   InitialBar that session), InitialBarZ is set to NaN
%                   for that whole session and a SkipReason is recorded
%                   for every channel in it, rather than dividing by zero.
%
%    PlayedTrC    - PlayedTr - 2.5 (centering only, no rescaling, since
%                   PlayedTr is assumed to have the same fixed range in
%                   every session - same fixed-step task structure - so
%                   only the intercept's reference point needs to shift,
%                   not the scale).
%
%  InitialBar and PlayedTr are NOT read from the downstream _BHV.mat
%  (which only has ChosenRewardSize / ChoiceOrNot). Instead they're
%  pulled directly from the RAW session file at
%  D:\Jeremiah_data\<key>.mat, using the exact same variable paths and
%  logic as gettrialdata2:
%    data.BHV.UserVars(1,k).InitialBarSz
%    data.BHV.UserVars(1,k).PlayedTr   (with carry-forward when ==0)
%  computed over all trials in the raw file, unconditional on
%  TrialError (gettrialdata2 doesn't filter these two fields either).
%  A trial-count mismatch between the raw file and the downstream
%  _BHV.mat causes the whole session to be skipped with a SkipReason,
%  since RewardSize/Choice/Exponent/Offset all still come from the
%  downstream files and must align trial-for-trial with InitialBar/
%  PlayedTr.
%
%  Everything else (per-file-key channel loading, NaN-padded placeholder
%  entries for every channel found on disk, nested M/N struct output,
%  parfor across session folders) is unchanged from the original.
%
%  OUTPUT LAYOUT (per channel):
%    M.<file>.<channel>.aperiodic_exponent.<predictor>.pValue
%    M.<file>.<channel>.aperiodic_exponent.<predictor>.coefficient
%    M.<file>.<channel>.offset.<predictor>.pValue
%    M.<file>.<channel>.offset.<predictor>.coefficient
%  where <predictor> in {intercept, rewardsize, choiceornochoice,
%  initialbar, playedtr}. (and same layout under N)
% ======================================================================

output_base_M = "Z:\users\Jeremiah\M";
output_base_N = "Z:\users\Jeremiah\N";
raw_input_folder = "D:\Jeremiah_data";   % source of <key>.mat raw session files (InitialBar/PlayedTr pulled from here)

CHANNELS_OF_INTEREST = {};   % e.g. {'LFP01','LFP02','LFP03'}
MIN_TRIALS_PER_CHANNEL = 10;

sessions = list_session_folders(output_base_M, output_base_N);
n_sessions = numel(sessions);
fprintf('Found %d session folders to process.\n', n_sessions);

if n_sessions == 0
    fprintf('Nothing to do. Exiting.\n');
    return
end

if isempty(gcp('nocreate'))
    c = parcluster('Processes');
    c.NumWorkers = 8;
    parpool(c, 8);
end

status = cell(1, n_sessions);
sessionData = cell(1, n_sessions);

parfor s = 1:n_sessions
    [status{s}, sessionData{s}] = process_one_session_glm(sessions(s), CHANNELS_OF_INTEREST, MIN_TRIALS_PER_CHANNEL, raw_input_folder);
end

fprintf('\n  --- Run summary ---\n');
for s = 1:n_sessions
    fprintf('%s: %s\n', sessions(s).key, status{s});
end

M = struct(); %#ok<NASGU>
N = struct(); %#ok<NASGU>

for s = 1:n_sessions
    validKey = matlab.lang.makeValidName(sessions(s).key);
    if isempty(fieldnames(sessionData{s}))
        continue
    end
    switch sessions(s).monkey
        case 'M'
            M.(validKey) = sessionData{s};
        case 'N'
            N.(validKey) = sessionData{s};
    end
end

if ~exist(output_base_M, 'dir')
    mkdir(output_base_M);
end
if ~exist(output_base_N, 'dir')
    mkdir(output_base_N);
end

save(fullfile(output_base_M, 'M_pupil_playedtr_initialbar_glm_results.mat'), 'M');
save(fullfile(output_base_N, 'N_pupil_playedtr_initialbar_glm_results.mat'), 'N');

fprintf('\nSaved %s\n', fullfile(output_base_M, 'M_glm_results.mat'));
fprintf('Saved %s\n', fullfile(output_base_N, 'N_glm_results.mat'));

%        _session_folders
function sessions = list_session_folders(output_base_M, output_base_N)

    sessions = struct('key', {}, 'folder', {}, 'monkey', {});
    bases = {output_base_M, output_base_N};

    for b = 1:numel(bases)
        base = bases{b};
        if ~exist(base, 'dir')
            continue
        end

        d = dir(base);
        d = d([d.isdir] & ~ismember({d.name}, {'.', '..'}));

        for i = 1:numel(d)
            key = d(i).name;
            monkey = key(1);
            if ~(monkey == 'M' || monkey == 'N')
                continue
            end
            sessions(end+1) = struct('key', key, 'folder', fullfile(base, key), 'monkey', monkey); %#ok<AGROW>
        end
    end
end


%  get_initialbar_playedtr_raw - loads <key>.mat from raw_input_folder
%  (the original D:\Jeremiah_data session file, upstream of
%  ap_reward_analysis.m) and pulls InitialBar and PlayedTr using the
%  SAME variable paths as gettrialdata2:
%    data.BHV.UserVars(1,k).InitialBarSz
%    data.BHV.UserVars(1,k).PlayedTr
%  including gettrialdata2's carry-forward rule for PlayedTr==0 (reuse
%  the previous trial's value). Computed over ALL trials, unconditional
%  on TrialError, exactly as gettrialdata2 does for these two fields
%  (no trial_complete filtering - that filtering in gettrialdata2 is
%  only applied to rewtyp/rewsz via the code-27 check).
%
%  Returns empty InitialBar/PlayedTr + a status string on any failure
%  (file not found, no 'data' field, missing UserVars fields) so the
%  caller can skip the session with a clear reason instead of crashing.
function [initialbar, playedtr, status_msg] = get_initialbar_playedtr_raw(key, raw_input_folder)

    initialbar = [];
    playedtr = [];

    % same exclusion list as average_pupil_size_extraction.m - these are
    % non-session aggregate/reference files that live in the same raw
    % folder and must never be loaded as if they were a session's trial
    % data, even if a session key happened to coincide with one.
    exclude_list = {'NLFP_APs.mat', 'NLFPareas.mat', 'N_primsec_LFPprobeAPs.mat', 'N0203.mat'};

    raw_filename = sprintf('%s.mat', key);
    if any(strcmpi(raw_filename, exclude_list))
        status_msg = sprintf('raw file "%s" is on the exclude list, not a session data file', raw_filename);
        return
    end

    raw_file = fullfile(raw_input_folder, raw_filename);
    if ~isfile(raw_file)
        status_msg = sprintf('raw file not found: %s', raw_file);
        return
    end

    raw = load(raw_file);
    if ~isfield(raw, 'data')
        status_msg = 'no "data" field found in raw file';
        return
    end
    data = raw.data;
    clear raw

    if ~isfield(data, 'NEURO') || ~isfield(data.NEURO, 'CodeNumbers2') ...
            || ~isfield(data, 'BHV') || ~isfield(data.BHV, 'UserVars')
        status_msg = 'raw file missing data.NEURO.CodeNumbers2 or data.BHV.UserVars';
        return
    end

    n_trials = length(data.NEURO.CodeNumbers2);
    initialbar = NaN(n_trials, 1);
    playedtr = NaN(n_trials, 1);

    for k = 1:n_trials
        if ~isfield(data.BHV.UserVars(1,k), 'InitialBarSz') || ~isfield(data.BHV.UserVars(1,k), 'PlayedTr')
            status_msg = sprintf('trial %d missing InitialBarSz/PlayedTr in UserVars', k);
            initialbar = [];
            playedtr = [];
            return
        end

        initialbar(k) = data.BHV.UserVars(1,k).InitialBarSz;
        playedtr(k,1) = data.BHV.UserVars(1,k).PlayedTr;

        if playedtr(k) == 0
            if k > 1
                playedtr(k) = playedtr(k-1);
            end
        end
    end

    status_msg = 'ok';
end

%  process_one_session_glm - every channel FILE FOUND ON DISK gets
%  exactly one entry in sessionChannels: NaN-padded by default,
%  overwritten with real coefficients only if the fit succeeds.
%
%  InitialBarZ is computed ONCE per session (not per channel), since
%  it only depends on BHV, not on channel data.
function [status_msg, sessionChannels] = process_one_session_glm(session, channels_of_interest, min_trials, raw_input_folder)

    PREDICTOR_NAMES = {'AvgPupil', 'InitialBarZ', 'PlayedTrC'};

    monkey = session.monkey;
    key = session.key;
    folder = session.folder;
    sessionChannels = struct();

    bhv_file = fullfile(folder, sprintf('%s_BHV.mat', key));
    if ~isfile(bhv_file)
        status_msg = 'no BHV file found, skipped';
        return
    end

    S = load(bhv_file);
    BHV = S.BHV;
    clear S

    RewardSize = BHV.ChosenRewardSize(:) - 2.5;
    Choice = BHV.ChoiceOrNot(:);
    Choice(Choice == 0) = -1;

    n_trials = length(RewardSize);

    [InitialBar, PlayedTr, raw_status] = get_initialbar_playedtr_raw(key, raw_input_folder);
    if isempty(InitialBar)
        status_msg = sprintf('raw file InitialBar/PlayedTr extraction failed: %s', raw_status);
        return
    end
    PlayedTrC  = PlayedTr - 2.5;

    if length(InitialBar) ~= n_trials || length(PlayedTr) ~= n_trials
        status_msg = sprintf(['trial count mismatch between _BHV.mat (n=%d) and raw file ' ...
            'InitialBar/PlayedTr (n=%d/%d) - check whether ap_reward_analysis.m filters trials ' ...
            'when writing _BHV.mat, skipped'], n_trials, length(InitialBar), length(PlayedTr));
        return
    end

    ib_mean = mean(InitialBar, 'omitnan');
    ib_std  = std(InitialBar, 'omitnan');
    session_ib_bad = (ib_std == 0) || isnan(ib_std);
    if session_ib_bad
        warning('%s: zero/NaN std for InitialBar this session - InitialBarZ set to NaN for all trials, all channels will be skipped.', key);
        InitialBarZ = NaN(size(InitialBar));
    else
        InitialBarZ = (InitialBar - ib_mean) / ib_std;
    end

    % extract avg pupil data - defensive checks throughout, since a
    % missing file/field/session-key here must produce a SkipReason via
    % status_msg rather than an uncaught error that would kill the
    % whole parfor (matches the pattern used for BHV/raw-file loading
    % above).
    if monkey == 'M'
        pupil_path = "Z:\users\Jeremiah\M\M_average_pupil_data.mat";
    else
        pupil_path = "Z:\users\Jeremiah\N\N_average_pupil_data.mat";
    end

    if ~isfile(pupil_path)
        status_msg = sprintf('avg pupil data file not found: %s', pupil_path);
        return
    end

    pupilFile = load(pupil_path);
    if ~isfield(pupilFile, monkey)
        status_msg = sprintf('avg pupil data file "%s" missing top-level field "%s"', pupil_path, monkey);
        return
    end
    pupilStruct = pupilFile.(monkey);

    pupilKey = matlab.lang.makeValidName(key);
    if ~isfield(pupilStruct, pupilKey)
        status_msg = sprintf('no avg pupil data found for session %s', key);
        return
    end
    if ~isfield(pupilStruct.(pupilKey), 'AveragePupilSize')
        status_msg = sprintf('avg pupil data for session %s missing AveragePupilSize field', key);
        return
    end
    AvgPupil = pupilStruct.(pupilKey).AveragePupilSize(:);

    if length(AvgPupil) ~= n_trials
        status_msg = sprintf('AvgPupil length (%d) does not match BHV trial count (%d)', ...
            length(AvgPupil), n_trials);
        return
    end

    chan_files = dir(fullfile(folder, sprintf('%s_*.mat', key)));
    chan_files = chan_files(~endsWith({chan_files.name}, '_BHV.mat'));
    chan_files = chan_files(~endsWith({chan_files.name}, '_ChannelOrder.mat'));
    chan_files = chan_files(~strcmpi({chan_files.name}, 'COMPLETE.mat'));

    n_fit = 0;
    n_skipped = 0;

    for c = 1:numel(chan_files)
        cf = chan_files(c).name;
        channelName = cf(length(key)+2 : end-4);

        if ~isempty(channels_of_interest) && ~ismember(channelName, channels_of_interest)
            continue   % deliberate scope restriction - no placeholder
        end

        validChannel = matlab.lang.makeValidName(channelName);

        % default: NaN-padded placeholder, overwritten below only if the
        % fit actually succeeds
        sessionChannels.(validChannel).aperiodic_exponent = nan_coef_struct(PREDICTOR_NAMES);
        sessionChannels.(validChannel).offset = nan_coef_struct(PREDICTOR_NAMES);
        sessionChannels.(validChannel).SkipReason = '';

        if session_ib_bad
            sessionChannels.(validChannel).SkipReason = 'session-level InitialBarZ undefined (zero/NaN std)';
            n_skipped = n_skipped + 1;
            continue
        end

        Sc = load(fullfile(folder, cf));
        if ~isfield(Sc, 'channelData')
            sessionChannels.(validChannel).SkipReason = 'no channelData field in file';
            n_skipped = n_skipped + 1;
            continue
        end
        exponent = Sc.channelData.Aperiodic.Exponents(:);
        offset   = Sc.channelData.Aperiodic.Offsets(:);
        clear Sc

        if length(exponent) ~= n_trials
            warning('%s / %s: trial count mismatch (BHV=%d, channel=%d), skipping.', ...
                key, channelName, n_trials, length(exponent));
            sessionChannels.(validChannel).SkipReason = sprintf( ...
                'trial count mismatch (BHV=%d, channel=%d)', n_trials, length(exponent));
            n_skipped = n_skipped + 1;
            continue
        end

        Tg = table();
        Tg.AvgPupilS   = AvgPupil;
        Tg.InitialBarZ = InitialBarZ;
        Tg.PlayedTrC   = PlayedTrC;
        Tg.Exponent    = exponent;
        Tg.Offset      = offset;

        validRows = ~ismissing(Tg.AvgPupilS) & ...
                    ~ismissing(Tg.InitialBarZ) & ~ismissing(Tg.PlayedTrC) & ...
                    ~ismissing(Tg.Exponent)    & ~ismissing(Tg.Offset);
        Tg = Tg(validRows, :);

        if height(Tg) < min_trials
            sessionChannels.(validChannel).SkipReason = sprintf( ...
                'too few valid trials (%d < %d)', height(Tg), min_trials);
            n_skipped = n_skipped + 1;
            continue
        end

        fit_ok = false;
        formula_rhs = 'AvgPupilS + InitialBarZ + PlayedTrC';

        try
            mdl_exp = fitglm(Tg, sprintf('Exponent ~ %s', formula_rhs));
            sessionChannels.(validChannel).aperiodic_exponent = extract_coef_struct(mdl_exp);
            fit_ok = true;
        catch ME
            warning('%s / %s: Exponent fitglm failed: %s', key, channelName, ME.message);
            sessionChannels.(validChannel).SkipReason = sprintf('Exponent fitglm failed: %s', ME.message);
        end

        try
            mdl_off = fitglm(Tg, sprintf('Offset ~ %s', formula_rhs));
            sessionChannels.(validChannel).offset = extract_coef_struct(mdl_off);
            fit_ok = true;
        catch ME
            warning('%s / %s: Offset fitglm failed: %s', key, channelName, ME.message);
            prevReason = sessionChannels.(validChannel).SkipReason;
            newReason = sprintf('Offset fitglm failed: %s', ME.message);
            if isempty(prevReason)
                sessionChannels.(validChannel).SkipReason = newReason;
            else
                sessionChannels.(validChannel).SkipReason = [prevReason '; ' newReason];
            end
        end

        if fit_ok
            n_fit = n_fit + 1;
        else
            n_skipped = n_skipped + 1;
        end
    end

    status_msg = sprintf('%d channels fit, %d skipped', n_fit, n_skipped);
end


% ======================================================================
%  extract_coef_struct - pulls Estimate + pValue for EVERY coefficient
%  actually present in the fitted GLM (intercept plus whatever
%  predictors made it into the formula), keyed by a lowercased/
%  friendly field name. Generalized (vs. hardcoding 3 predictors) so
%  adding/removing predictors doesn't require touching this function.
% ======================================================================
function s = extract_coef_struct(mdl)
    s = struct();
    coefNames = mdl.CoefficientNames;

    name_map = containers.Map( ...
        {'(Intercept)', 'AvgPupilS', 'InitialBarZ', 'PlayedTrC'}, ...
        {'intercept',   'avgpupil', 'initialbar', 'playedtr'});

    for i = 1:numel(coefNames)
        raw = coefNames{i};
        if isKey(name_map, raw)
            fieldName = name_map(raw);
        else
            fieldName = matlab.lang.makeValidName(lower(raw));
        end
        s.(fieldName) = struct( ...
            'coefficient', mdl.Coefficients.Estimate(i), ...
            'pValue',      mdl.Coefficients.pValue(i));
    end

    % ensure the standard fields always exist even if a formula term
    % happened to drop out (keeps downstream struct access uniform)
    for fieldName = {'intercept','rewardsize','choiceornochoice','initialbar','playedtr'}
        if ~isfield(s, fieldName{1})
            s.(fieldName{1}) = struct('coefficient', NaN, 'pValue', NaN);
        end
    end

    s.N = mdl.NumObservations;
end

% ======================================================================
%  nan_coef_struct - same shape as extract_coef_struct's output, used
%  as the up-front default before a fit is attempted/succeeds.
%  predictor_names: cell array of predictor names as used in the
%  formula (e.g. {'RewardSize','Choice','InitialBarZ','PlayedTrC'}) -
%  translated to friendly field names via the same map used above.
% ======================================================================
function s = nan_coef_struct(predictor_names) %#ok<INUSD>
    s = struct();
    s.intercept        = struct('coefficient', NaN, 'pValue', NaN);
    s.rewardsize       = struct('coefficient', NaN, 'pValue', NaN);
    s.choiceornochoice = struct('coefficient', NaN, 'pValue', NaN);
    s.initialbar       = struct('coefficient', NaN, 'pValue', NaN);
    s.playedtr         = struct('coefficient', NaN, 'pValue', NaN);
    s.N = 0;
end